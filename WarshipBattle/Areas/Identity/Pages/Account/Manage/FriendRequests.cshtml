@page
@model WarshipBattle.Areas.Identity.Pages.Account.Manage.FriendRequestsModel

@{
    ViewData["Title"] = "Friend Requests";
}

<h2>Friend Requests</h2>

@if (Model.Requests != null && Model.Requests.Any())
{
    foreach (var request in Model.Requests)
    {
        <div class="request">
            <span>@request.SenderUserName</span>
            <form asp-page-handler="AcceptRequest" asp-route-requestId="@request.Id">
                <button type="submit" class="btn btn-success">Accept</button>
            </form>
            <form asp-page-handler="DeclineRequest" asp-route-requestId="@request.Id">
                <button type="submit" class="btn btn-danger">Decline</button>
            </form>
        </div>
    }
}
else
{
    <p>No friend requests.</p>
}