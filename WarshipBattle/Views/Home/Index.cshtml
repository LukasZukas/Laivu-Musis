@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4 battleship-title">⚓ Laivų mūšis</h1>
    <a asp-controller="Game" asp-action="GameModes" class="btn btn-custom">⚓ Choose Game Mode</a>
</div>

<style>
    /* Šviesus režimas */
    [data-theme="light"] body {
        background-image: url('/images/sprites/warship_background.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        min-height: 100vh;
    }

    /* Tamsus režimas */
    [data-theme="dark"] body {
        background: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)), url('/images/sprites/warship_background.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        min-height: 100vh;
    }

    .battleship-title {
        font-family: 'Special Elite', cursive;
        color: #1a2526;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
    }

    [data-theme="dark"] .battleship-title {
        color: #ffffff;
        text-shadow: 2px 2px 4px rgba(255, 255, 255, 0.3);
    }

    .btn-custom {
        background-image: url('/images/sprites/wood_background.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        color: white;
        padding: 10px 20px;
        border: none;
        border-radius: 5px;
        font-weight: bold;
        box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.3);
        transition: opacity 0.2s;
    }

        .btn-custom:hover {
            opacity: 0.9; /* Subtilus patamsinimas užvedus pelę */
        }
</style>
